{
  "name": "playtest-forge",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "UHQ three.js Spyro-inspired creature platformer forge — agents design, build, playtest",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config games/creature-island/vite.config.ts",
    "dev:island": "vite --config games/creature-island/vite.config.ts",
    "playtest": "tsx tools/playtest.ts",
    "playtest:island": "tsx tools/playtest.ts --game creature-island --seconds 25",
    "playtest:opus": "tsx tools/playtest.ts --game smoke-opus --port 5174 --seconds 25",
    "playtest:sol": "tsx tools/playtest.ts --game smoke-sol --port 5175 --seconds 25",
    "dev:fox": "vite --config games/fox-spirit/vite.config.ts --port 5180",
    "playtest:fox": "tsx tools/playtest.ts --game fox-spirit --port 5180 --seconds 30 --script shrine",
    "playtest:fox-feel": "tsx tools/playtest.ts --game fox-spirit --port 5180 --seconds 12 --script feel-probe",
    "dev:lookdev": "vite --config games/lookdev/vite.config.ts",
    "playtest:lookdev": "tsx tools/playtest.ts --game lookdev --port 5190 --seconds 22"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@types/node": "^24.9.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "lil-gui": "^0.21.0",
    "postprocessing": "^6.38.3",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
