{
  "name": "playtest-forge",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "UHQ three.js Spyro-inspired creature platformer forge \u2014 agents design, build, playtest",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config games/fox-spirit/vite.config.ts --port 5180",
    "playtest": "tsx tools/playtest.ts --game fox-spirit --port 5180 --seconds 30 --script shrine",
    "playtest:feel": "tsx tools/playtest.ts --game fox-spirit --port 5180 --seconds 12 --script feel-probe",
    "fox:turntable": "tsx tools/fox-turntable.ts --fx 0 --anim idle"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@types/node": "^24.9.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
